:root{--red-1:#250902;--red-2:#38040e;--red-3:#640D14;--red-4:#800e13;--red-5:#AD2831;--white:#ffffff;--offwhite:#f7f7f7;--light-gray:#e5e5e5;--gray:#777;--dark-gray:#333;--black:#111;--brand-primary:var(--red-5);--brand-secondary:var(--red-3);--brand-dark:var(--red-1)}body{background-color:var(--offwhite);color:var(--dark-gray)}.section-dark{background-color:var(--red-1);color:var(--offwhite)}.section-accent{background-color:var(--red-3);color:var(--white)}h1,h2,h3,h4,h5,h6{color:var(--red-1);font-weight:800}p,li,span{color:var(--dark-gray)}.text-muted{color:var(--gray)!important}a{color:var(--red-5);text-decoration:none;font-weight:600}a:hover{color:var(--red-4);text-decoration:underline}.btn-primary{background-color:var(--red-5);border-color:var(--red-5);color:var(--white)}.btn-primary:hover{background-color:var(--red-4);border-color:var(--red-4)}.btn-secondary{background-color:transparent;border:2px solid var(--red-5);color:var(--red-5)}.btn-secondary:hover{background-color:var(--red-5);color:var(--white)}.card{background-color:var(--white);border:1px solid var(--light-gray);border-radius:12px;padding:1.5rem;transition:all .25s ease}.card:hover{border-color:var(--red-5);box-shadow:0 6px 20px rgba(173,40,49,.25)}.card-title{color:var(--red-1);font-weight:700}.card-meta{color:var(--gray);font-size:.9rem}footer{background-color:var(--red-1);color:var(--offwhite);padding:2.5rem 0;border-top:4px solid var(--red-5)}footer a{color:var(--red-5)}footer a:hover{color:var(--red-4)}.hero{padding:5rem 0;background:linear-gradient(135deg,var(--red-1) 0%,var(--red-2) 35%,var(--red-3) 70%,var(--red-4) 100%);color:var(--white);border-bottom:6px solid var(--red-5)}.hero .pre-title{color:var(--red-5)}.hero h1{color:var(--white)}.hero p{color:var(--offwhite)}.profile-img{max-width:260px;border-radius:12px;border:3px solid var(--red-5);box-shadow:0 6px 20px rgba(0,0,0,.4)}.language-section{padding:3rem 0}.language-logo{max-width:180px;border-radius:12px;border:3px solid var(--red-5);box-shadow:0 6px 20px rgba(0,0,0,.3)}.language-header{background-color:var(--red-1);padding:1rem 0;border-radius:8px;max-width:500px;margin:1.5rem auto 0}.language-title{color:var(--red-5);font-weight:800;margin:0;letter-spacing:1px}.language-links{margin-top:1.5rem;display:flex;justify-content:center;gap:2rem}.lang-link{font-size:1.2rem;font-weight:700;color:var(--red-3);text-decoration:none;padding:.5rem 1rem;border-bottom:2px solid transparent;transition:all .25s ease}.lang-link:hover{color:var(--red-5);border-bottom:2px solid var(--red-5)}.hero-section{min-height:85vh;display:flex;align-items:center;position:relative;background:linear-gradient(135deg,#0A0808 0%,#1A1515 100%);overflow:hidden;padding:3rem 0}.hero-section::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background-image:radial-gradient(circle at 25% 50%,rgba(128,0,0,.15) 0%,transparent 50%),repeating-linear-gradient(45deg,rgba(255,0,51,3%) 0,rgba(255,0,51,3%) 2px,transparent 2px,transparent 8px);pointer-events:none}.hero-card{background:rgba(245,240,232,.95);backdrop-filter:blur(12px);border-radius:24px;max-width:850px;width:90%;margin:0 auto;padding:3rem;box-shadow:0 12px 24px rgba(0,0,0,.3);transition:transform .3s ease,box-shadow .3s ease;position:relative;z-index:2;border:1px solid rgba(198,164,63,.2)}.hero-card:hover{transform:translateY(-8px);box-shadow:0 12px 24px rgba(0,0,0,.3),0 0 30px rgba(198,164,63,.3);border-color:rgba(198,164,63,.4)}.hero-content{text-align:center}.pre-title{font-family:montserrat,helvetica neue,segoe ui,sans-serif;font-size:.85rem;letter-spacing:.3em;text-transform:uppercase;color:#d10000;margin-bottom:1rem;font-weight:500}.hero-card h1{font-family:cormorant garamond,playfair display,Georgia,serif;font-size:3.8rem;font-weight:600;background:linear-gradient(135deg,maroon 0%,#960018 50%,#d10000 100%);-webkit-background-clip:text;background-clip:text;color:transparent;margin-bottom:1.5rem;letter-spacing:-.02em}.homepage-intro{font-family:cormorant garamond,playfair display,Georgia,serif;font-size:1.15rem;line-height:1.8;color:#1a1515;margin-bottom:2rem;text-align:center;font-weight:400}.hero-buttons{display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap}.btn{display:inline-block;padding:1rem 3rem;border-radius:40px;font-family:montserrat,helvetica neue,segoe ui,sans-serif;font-weight:600;text-decoration:none;transition:all .3s ease;cursor:pointer;letter-spacing:.05em;font-size:.9rem}.btn-primary{background:linear-gradient(135deg,maroon 0%,#960018 50%,#d10000 100%);color:#fff;border:none;position:relative;overflow:hidden}.btn-primary::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),transparent);transition:left .3s ease}.btn-primary:hover::before{left:100%}.btn-primary:hover{transform:translateY(-2px);box-shadow:0 0 30px rgba(209,0,0,.3)}.btn-secondary{background:0 0;border:2px solid #d10000;color:#d10000}.btn-secondary:hover{background:linear-gradient(135deg,maroon 0%,#960018 50%,#d10000 100%);color:#fff;border-color:transparent;transform:translateY(-2px);box-shadow:0 0 30px rgba(209,0,0,.3)}.blog-section{padding:5rem 0;background:#0a0808}.section-title{font-family:montserrat,helvetica neue,segoe ui,sans-serif;font-size:2.2rem;text-align:center;color:#c6a43f;letter-spacing:.1em;margin-bottom:3rem;position:relative}.section-title::after{content:'';position:absolute;bottom:-1rem;left:50%;transform:translateX(-50%);width:60px;height:2px;background:linear-gradient(135deg,maroon 0%,#960018 50%,#d10000 100%)}.card-premium{background:#1a1515;border-radius:16px;padding:2rem;margin-bottom:2rem;transition:all .3s ease;border:1px solid rgba(198,164,63,.1);height:100%}.card-premium:hover{transform:translateY(-5px);border-color:rgba(198,164,63,.3);box-shadow:0 8px 16px rgba(0,0,0,.2)}.card-premium h3{font-family:cormorant garamond,playfair display,Georgia,serif;font-size:1.5rem;margin-bottom:1rem}.card-premium h3 a{color:#f5f0e8;text-decoration:none;transition:color .2s ease}.card-premium h3 a:hover{color:#c6a43f}.card-premium p{color:#b8a99a;line-height:1.6;margin-bottom:1.5rem}.card-premium .read-more{color:#d10000;text-decoration:none;font-weight:500;transition:color .2s ease}.card-premium .read-more:hover{color:#c6a43f}.language-tabs{display:flex;gap:1.5rem;justify-content:center;margin:3rem 0}.lang-tab{padding:1rem 2rem;border-radius:40px;text-decoration:none;font-family:montserrat,helvetica neue,segoe ui,sans-serif;font-weight:500;font-size:.9rem;background:rgba(245,240,232,.1);color:#f5f0e8;border:1px solid rgba(198,164,63,.3);transition:all .3s ease}.lang-tab:hover,.lang-tab.active{background:linear-gradient(135deg,maroon 0%,#960018 50%,#d10000 100%);color:#fff;border-color:transparent;transform:translateY(-2px);box-shadow:0 0 30px rgba(209,0,0,.3)}@media(max-width:768px){.hero-card{padding:2rem}.hero-card h1{font-size:2.2rem}.homepage-intro{font-size:1rem}.btn{padding:.5rem 2rem;font-size:.85rem}.section-title{font-size:1.8rem}.card-premium h3{font-size:1.2rem}.language-tabs{gap:1rem;flex-wrap:wrap}.lang-tab{padding:.5rem 1.5rem;font-size:.8rem}}@keyframes fadeInUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}.hero-card{animation:fadeInUp .8s ease-out}*{margin:0;padding:0;box-sizing:border-box}body{font-family:cormorant garamond,playfair display,Georgia,serif;background:#0a0808;color:#e8e0d5;line-height:1.6;overflow-x:hidden}::selection{background:#d10000;color:#fff}::-webkit-scrollbar{width:8px}::-webkit-scrollbar-track{background:#1a1515}::-webkit-scrollbar-thumb{background:#d10000;border-radius:4px}::-webkit-scrollbar-thumb:hover{background:#c6a43f}