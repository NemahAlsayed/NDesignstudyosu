{{ define "main" }}
<!-- Premium Hero Section -->
<section style="min-height: 90vh; display: flex; align-items: center; justify-content: center; position: relative; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); overflow: hidden;">
  
  <!-- Background Pattern -->
  <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0.1;">
    <div style="position: absolute; top: 10%; left: 5%; width: 300px; height: 300px; background: white; border-radius: 50%; filter: blur(80px);"></div>
    <div style="position: absolute; bottom: 10%; right: 5%; width: 400px; height: 400px; background: white; border-radius: 50%; filter: blur(100px);"></div>
  </div>
  
  <!-- Hero Card -->
  <div style="max-width: 900px; width: 90%; margin: 0 auto; position: relative; z-index: 2;">
    <div style="background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(10px); border-radius: 32px; padding: 60px 50px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); text-align: center; transition: transform 0.3s ease;">
      
      <!-- Small Label -->
      <div style="margin-bottom: 20px;">
        <span style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 6px 16px; border-radius: 50px; font-family: 'Montserrat', sans-serif; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.5px; display: inline-block;">
          {{ .Site.Params.homepage.preTitle | default "WELCOME TO" }}
        </span>
      </div>
      
      <!-- Main Title -->
      <h1 style="font-family: 'Cormorant Garamond', serif; font-size: 4rem; font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: 20px; line-height: 1.2;">
        {{ .Site.Params.homepage.title | default "N Design Studio" }}
      </h1>
      
      <!-- Description -->
      <p style="font-family: 'Cormorant Garamond', serif; font-size: 1.2rem; line-height: 1.7; color: #4a5568; margin-bottom: 40px; max-width: 600px; margin-left: auto; margin-right: auto;">
        {{ .Site.Params.homepage.intro | default "Creative Design for Purposeful Impact" }}
      </p>
      
      <!-- Call to Action Buttons -->
      <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px;">
        <a href="/{{ .Lang }}/posts/" 
           style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 14px 32px; border-radius: 50px; text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
          <span>{{ .Site.Params.homepage.mainButton | default "Explore Blog" }}</span>
          <span style="font-size: 1.1rem;">→</span>
        </a>
        <a href="/{{ .Lang }}/about/" 
           style="background: transparent; border: 2px solid #667eea; color: #667eea; padding: 14px 32px; border-radius: 50px; text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 10px;">
          <span>{{ .Site.Params.homepage.secondButton | default "About Me" }}</span>
        </a>
      </div>
      
      <!-- Quick Stats / Navigation Helpers -->
      <div style="display: flex; justify-content: center; gap: 30px; flex-wrap: wrap; padding-top: 30px; border-top: 1px solid rgba(0,0,0,0.1);">
        <div style="text-align: center;">
          <div style="font-family: 'Montserrat', sans-serif; font-size: 1.8rem; font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
            {{ len (where .Site.RegularPages "Section" "posts") }}+
          </div>
          <div style="font-family: 'Montserrat', sans-serif; font-size: 0.8rem; color: #718096;">Articles</div>
        </div>
        <div style="text-align: center;">
          <div style="font-family: 'Montserrat', sans-serif; font-size: 1.8rem; font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
            3+
          </div>
          <div style="font-family: 'Montserrat', sans-serif; font-size: 0.8rem; color: #718096;">Languages</div>
        </div>
        <div style="text-align: center;">
          <div style="font-family: 'Montserrat', sans-serif; font-size: 1.8rem; font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
            100% 
          </div>
          <div style="font-family: 'Montserrat', sans-serif; font-size: 0.8rem; color: #718096;">Creative</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Posts Section (Preview) -->
<section style="padding: 80px 20px; background: white;">
  <div style="max-width: 1200px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 60px;">
      <h2 style="font-family: 'Montserrat', sans-serif; font-size: 2.2rem; color: #1a1a1a; margin-bottom: 16px;">{{ .Site.Params.homepage.blogTitle | default "Latest Stories" }}</h2>
      <p style="font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; color: #4a5568;">Discover our latest articles and insights</p>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 30px;">
      {{ range first 3 (where .Site.RegularPages "Section" "posts") }}
      <div style="background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1); transition: all 0.3s ease; cursor: pointer;">
        <a href="{{ .Permalink }}" style="text-decoration: none;">
          {{ $img := .Resources.GetMatch .Params.featured_image }}
          {{ if not $img }}
            {{ $img = index (.Resources.ByType "image") 0 }}
          {{ end }}
          {{ with $img }}
            <img src="{{ .RelPermalink }}" alt="{{ $.Title }}" style="width: 100%; height: 240px; object-fit: cover;">
          {{ else }}
            <div style="width: 100%; height: 240px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
              <i class="fas fa-newspaper" style="font-size: 3rem; color: white;"></i>
            </div>
          {{ end }}
          <div style="padding: 24px;">
            <h3 style="font-family: 'Montserrat', sans-serif; font-size: 1.3rem; color: #1a1a1a; margin-bottom: 12px;">{{ .Title }}</h3>
            <p style="font-family: 'Cormorant Garamond', serif; font-size: 1rem; line-height: 1.6; color: #4a5568; margin-bottom: 16px;">{{ .Summary | truncate 100 }}</p>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="color: #667eea; font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 600;">Read More →</span>
              <span style="font-family: 'Montserrat', sans-serif; font-size: 0.75rem; color: #a0aec0;">{{ .Date.Format "Jan 2, 2006" }}</span>
            </div>
          </div>
        </a>
      </div>
      {{ end }}
    </div>
    
    <div style="text-align: center; margin-top: 50px;">
      <a href="/{{ .Lang }}/posts/" 
         style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 12px 32px; border-radius: 50px; text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 10px;">
        {{ .Site.Params.homepage.blogButton | default "View All Posts" }}
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<!-- Hover Effects Script -->
<style>
  .hero-card-hover:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 60px -12px rgba(0,0,0,0.25);
  }
  
  .btn-hover:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -5px rgba(102, 126, 234, 0.4);
  }
  
  .card-hover:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px -12px rgba(0,0,0,0.15);
  }
  
  @media (max-width: 768px) {
    [style*="padding: 60px 50px"] {
      padding: 40px 25px !important;
    }
    [style*="font-size: 4rem"] {
      font-size: 2.5rem !important;
    }
    [style*="gap: 30px"] {
      gap: 15px !important;
    }
  }
</style>
{{ end }}
