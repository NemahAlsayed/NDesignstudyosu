baseURL = "https://ndesignstudyosu.com.tr/"
languageCode = "en-us"
title = "N Design Studio"
theme = "magnolia"
copyright = "&copy; 2026 N Design Studio. All rights reserved."
googleAnalytics = "G-MG76R19NGW"

defaultContentLanguage = "en"
defaultContentLanguageInSubdir = true

# FIXED
relativeURLs = false
canonifyURLs = true

[params]
  subtitle = "Creative Design for Purposeful Impact"

[params.social]
  twitter = "https://twitter.com/NDesignStudyosu"
  instagram = "https://instagram.com/ndesignstudyosu"
  facebook = "https://www.facebook.com/profile.php?id=61584092261123"
  youtube = "https://www.youtube.com/@ndesignstudio7937"
  tiktok = "https://www.tiktok.com/@ndesignstudyosu"

[languages]
[languages.en]
  weight = 1
  contentDir = "content/en"
  languageName = "English"
  
  [[languages.en.menu.main]]
    name = "About"
    url = "/about/"
    weight = 1
  [[languages.en.menu.main]]
    name = "Contact"
    url = "/contact/"
    weight = 2

[languages.tr]
  weight = 2
  contentDir = "content/tr"
  languageName = "Türkçe"
  
  [[languages.tr.menu.main]]
    name = "Hakkında"
    url = "/about/"
    weight = 1
  [[languages.tr.menu.main]]
    name = "İletişim"
    url = "/contact/"
    weight = 2

[languages.ar]
  weight = 3
  contentDir = "content/ar"
  languageName = "العربية"
  
  [[languages.ar.menu.main]]
    name = "حول"
    url = "/about/"
    weight = 1
  [[languages.ar.menu.main]]
    name = "اتصل بنا"
    url = "/contact/"
    weight = 2

[markup]
  [markup.goldmark]
    [markup.goldmark.renderer]
      unsafe = true

[module]
  [[module.mounts]]
    source = "assets"
    target = "assets"
  [[module.mounts]]
    source = "static"
    target = "static"

[build]
  writeStats = true

[module]
  [[module.mounts]]
    source = "assets"
    target = "assets"
  [[module.mounts]]
    source = "static"
    target = "static"

[build]
  writeStats = true
  noJSConfigInAssets = false
