#xA;            margin: 0.8rem 0;&#xA;            font-weight: 500;&#xA;        }&#xA;&#xA;        .btn-reveal:hover {&#xA;            background: #3a2a1f;&#xA;            transform: scale(0.98);&#xA;        }&#xA;&#xA;        .coupon-hidden {&#xA;            max-height: 0;&#xA;            opacity: 0;&#xA;            overflow: hidden;&#xA;            transition: 0.4s ease;&#xA;            background: #ffffffdb;&#xA;            border-radius: 40px;&#xA;            margin-top: 0px;&#xA;        }&#xA;        .coupon-hidden.show {&#xA;            max-height: 260px;&#xA;            opacity: 1;&#xA;            padding: 1rem;&#xA;            margin-top: 1.2rem;&#xA;            border: 1px dashed #c7a47b;&#xA;        }&#xA;&#xA;        .code-block {&#xA;            font-size: 2rem;&#xA;            letter-spacing: 6px;&#xA;            font-weight: bold;&#xA;            background: #2c2a27;&#xA;            color: #fadfbb;&#xA;            display: inline-block;&#xA;            padding: 0.2rem 1rem;&#xA;            border-radius: 40px;&#xA;            font-family: monospace;&#xA;        }&#xA;&#xA;        .footer-editorial {&#xA;            border-top: 1px solid #e2cfbe;&#xA;            margin-top: 2rem;&#xA;            padding: 2rem;&#xA;            text-align: center;&#xA;            font-size: 0.7rem;&#xA;            color: #aa9b8b;&#xA;        }&#xA;&#xA;        @media (max-width: 760px) {&#xA;            .hero-editorial {&#xA;                flex-direction: column;&#xA;                padding: 1.5rem;&#xA;            }&#xA;            .hero-text h1 {&#xA;                font-size: 2.2rem;&#xA;            }&#xA;            .product-grid {&#xA;                padding: 0 1rem;&#xA;                gap: 1rem;&#xA;            }&#xA;            .love-note, .coupon-mystery {&#xA;                margin: 1rem;&#xA;            }&#xA;        }&#xA;    &lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;&lt;div class=&#34;vogue-container&#34;&gt;&#xA;    &lt;div class=&#34;editorial-