30px);&#xA;            }&#xA;            to {&#xA;                opacity: 1;&#xA;                transform: translateY(0);&#xA;            }&#xA;        }&#xA;&#xA;        .product-card .img-placeholder {&#xA;            width: 100%;&#xA;            aspect-ratio: 1 / 1.1;&#xA;            background: #f9f2e6;&#xA;            display: flex;&#xA;            align-items: center;&#xA;            justify-content: center;&#xA;            border-bottom: 2px solid #e8d5b5;&#xA;            overflow: hidden;&#xA;        }&#xA;&#xA;        .product-card .img-placeholder img {&#xA;            width: 100%;&#xA;            height: 100%;&#xA;            object-fit: cover;&#xA;            transition: transform 0.6s ease;&#xA;        }&#xA;&#xA;        .product-card:hover .img-placeholder img {&#xA;            transform: scale(1.04);&#xA;        }&#xA;&#xA;        .product-card .product-info {&#xA;            padding: 1.2rem 1.4rem 1.4rem;&#xA;        }&#xA;&#xA;        .product-card .product-info h3 {&#xA;            font-size: 1.15rem;&#xA;            color: #5c3b1f;&#xA;            font-weight: 600;&#xA;            margin-bottom: 0.4rem;&#xA;        }&#xA;&#xA;        .product-card .product-info .product-rating {&#xA;            display: flex;&#xA;            align-items: center;&#xA;            gap: 0.3rem;&#xA;            margin-bottom: 0.5rem;&#xA;        }&#xA;&#xA;        .product-card .product-info .product-rating span {&#xA;            color: #b8860b;&#xA;            font-size: 0.9rem;&#xA;        }&#xA;&#xA;        .product-card .product-info .product-rating .rating-text {&#xA;            color: #a28b6f;&#xA;            font-size: 0.75rem;&#xA;        }&#xA;&#xA;        .product-card .product-info p {&#xA;            font-size: 0.9rem;&#xA;            color: #6b4a2a;&#xA;            line-height: 1.7;&#xA;            margin-bottom: 0.8rem;&#xA;        }&#xA;&#xA;        .btn-shop {&#xA;            display: inline-block;&#xA;            background: #5c3b1f;&#xA;            