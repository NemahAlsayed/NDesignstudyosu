30px);&#xA;            }&#xA;            to {&#xA;                opacity: 1;&#xA;                transform: translateY(0);&#xA;            }&#xA;        }&#xA;&#xA;        .product-card .img-placeholder {&#xA;            width: 100%;&#xA;            aspect-ratio: 1 / 1.1;&#xA;            background: #f9f2e6;&#xA;            display: flex;&#xA;            align-items: center;&#xA;            justify-content: center;&#xA;            border-bottom: 2px solid #e8d5b5;&#xA;            overflow: hidden;&#xA;            padding: 1rem;&#xA;        }&#xA;&#xA;        .product-card .img-placeholder img {&#xA;            width: 100%;&#xA;            height: 100%;&#xA;            object-fit: contain;&#xA;            transition: transform 0.6s ease;&#xA;        }&#xA;&#xA;        .product-card:hover .img-placeholder img {&#xA;            transform: scale(1.04);&#xA;        }&#xA;&#xA;        .product-card .product-info {&#xA;            padding: 1.2rem 1.4rem 1.4rem;&#xA;        }&#xA;&#xA;        .product-card .product-info h3 {&#xA;            font-size: 1.15rem;&#xA;            color: #5c3b1f;&#xA;            font-weight: 600;&#xA;            margin-bottom: 0.4rem;&#xA;        }&#xA;&#xA;        .product-card .product-info .product-rating {&#xA;            display: flex;&#xA;            align-items: center;&#xA;            gap: 0.3rem;&#xA;            margin-bottom: 0.5rem;&#xA;        }&#xA;&#xA;        .product-card .product-info .product-rating span {&#xA;            color: #b8860b;&#xA;            font-size: 0.9rem;&#xA;        }&#xA;&#xA;        .product-card .product-info .product-rating .rating-text {&#xA;            color: #a28b6f;&#xA;            font-size: 0.75rem;&#xA;        }&#xA;&#xA;        .product-card .product-info p {&#xA;            font-size: 0.9rem;&#xA;            color: #6b4a2a;&#xA;            line-height: 1.7;&#xA;            margin-bottom: 0.8rem;&#xA;        }&#xA;&#xA;        .btn-shop {&#xA;            display: inline-block;&#xA;            background: #5c3b1f;&#xA;            color: #fef3e2;&#xA;            padding: 0.5rem 1.4rem;&#xA;            border-radius: 40px;&#xA;            text-decoration: none;&#xA;            font-weight: 500;&#xA;            font-size: 0.85rem;&#xA;            transition: all 0.3s ease;&#xA;            border: none;&#xA;            cursor: pointer;&#xA;        }&#xA;&#xA;        .btn-shop:hover {&#xA;            background: #b8860b;&#xA;            transform: scale(0.97);&#xA;            box-shadow: 0 4px 15px rgba(184, 134, 11, 0.3);&#xA;        }&#xA;&#xA;        .btn-shop::after {&#xA;            content: &#39; →&#39;;&#xA;            transition: transform 0.3s ease;&#xA;            display: inline-block;&#xA;        }&#xA;&#xA;        .btn-shop:hover::after {&#xA;            transform: translateX(4px);&#xA;        }&#xA;&#xA;        /* ===== COUPON BOX ===== */&#xA;        .coupon-box {&#xA;            background: linear-gradient(135deg, #fef6e8, #fbefdb);&#xA;            margin: 0 2.5rem 2.5rem;&#xA;            border-radius: 32px;&#xA;            text-align: center;&#xA;            padding: 2rem;&#xA;            border: 1px solid rgba(184, 134, 11, 0.15);&#xA;            position: relative;&#xA;            overflow: hidden;&#xA;        }&#xA;&#xA;        .coupon-box::before {&#xA;            content: &#39;✦ ✦ ✦&#39;;&#xA;            position: absolute;&#xA;            top: -10px;&#xA;            right: -10px;&#xA;            font-size: 3rem;&#xA;            color: rgba(184, 134, 11, 0.06);&#xA;            letter-spacing: 10px;&#xA;        }&#xA;&#xA;        .coupon-box h3 {&#xA;            font-size: 1.6rem;&#xA;            color: #5c3b1f;&#xA;            font-weight: 700;&#xA;            margin-bottom: 0.5rem;&#xA;        }&#xA;&#xA;        .coupon-box .coupon-code {&#xA;            display: inline-block;&#xA;            background: #5c3b1f;&#xA;            color: #fef3e2;&#xA;            padding: 0.4rem 2rem;&#xA;            border-radius: 40px;&#xA;            font-w