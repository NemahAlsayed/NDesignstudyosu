<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Personal Experience on N Design Studio</title><link>https://ndesignstudyosu.com.tr/en/categories/personal-experience/</link><description>Recent content in Personal Experience on N Design Studio</description><generator>Hugo</generator><language>en</language><lastBuildDate>Sun, 05 Jul 2026 00:00:00 +0300</lastBuildDate><atom:link href="https://ndesignstudyosu.com.tr/en/categories/personal-experience/index.xml" rel="self" type="application/rss+xml"/><item><title>My Products Review of L'Occitane used and tried favourites (Global Edition With Exclusive Discount Code A162)</title><link>https://ndesignstudyosu.com.tr/en/posts/2026/06/loccitane-review-a162-en/</link><pubDate>Sun, 05 Jul 2026 00:00:00 +0300</pubDate><guid>https://ndesignstudyosu.com.tr/en/posts/2026/06/loccitane-review-a162-en/</guid><description>&lt;!DOCTYPE html&gt;
&lt;html lang="en" dir="ltr"&gt;
&lt;head&gt;
 &lt;meta charset="UTF-8"&gt;
 &lt;meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"&gt;
 &lt;title&gt;My L'OCCITANE Discovery: 5 Products That Transformed My Daily Ritual&lt;/title&gt;

 &lt;style&gt;
 /* ===== RESET &amp; BASE ===== */
 * {
 margin: 0;
 padding: 0;
 box-sizing: border-box;
 }

 body {
 font-family: 'Segoe UI', 'Helvetica Neue', system-ui, sans-serif;
 background: linear-gradient(145deg, #faf6ef 0%, #f5ede0 100%);
 padding: 2rem 1rem;
 line-height: 1.7;
 color: #4a3724;
 min-height: 100vh;
 display: flex;
 align-items: center;
 justify-content: center;
 }

 /* ===== MAIN CARD ===== */
 .blog-card {
 max-width: 1200px;
 width: 100%;
 margin: 0 auto;
 background: #ffffff;
 border-radius: 48px;
 overflow: hidden;
 box-shadow: 0 35px 50px -25px rgba(0, 0, 0, 0.25);
 transition: transform 0.4s ease, box-shadow 0.4s ease;
 }

 .blog-card:hover {
 transform: translateY(-4px);
 box-shadow: 0 50px 65px -30px rgba(0, 0, 0, 0.3);
 }

 /* ===== HERO SECTION ===== */
 .hero-luxury {
 background: linear-gradient(135deg, #f3e5c9 0%, #e8d5b5 50%, #dcc49a 100%);
 padding: 3.5rem 2.5rem;
 text-align: center;
 border-bottom: 4px solid #b8860b;
 position: relative;
 overflow: hidden;
 }

 .hero-luxury::before {
 content: '✦';
 position: absolute;
 top: 10px;
 right: 30px;
 font-size: 2rem;
 color: rgba(184, 134, 11, 0.15);
 animation: float 6s ease-in-out infinite;
 }

 .hero-luxury::after {
 content: '✦';
 position: absolute;
 bottom: 10px;
 left: 30px;
 font-size: 2rem;
 color: rgba(184, 134, 11, 0.15);
 animation: float 6s ease-in-out infinite 3s;
 }

 @keyframes float {
 0%, 100% {
 transform: translateY(0) rotate(0deg);
 }
 50% {
 transform: translateY(-10px) rotate(180deg);
 }
 }

 .hero-luxury h1 {
 font-size: 2.6rem;
 font-weight: 700;
 color: #5c3b1f;
 margin-bottom: 0.75rem;
 letter-spacing: -0.5px;
 animation: fadeSlideUp 0.8s ease-out;
 }

 .hero-luxury .subtitle {
 font-size: 1.15rem;
 color: #7a552e;
 font-weight: 400;
 }

 .hero-luxury .subtitle strong {
 color: #b8860b;
 font-weight: 600;
 }

 .hero-luxury .discount-badge {
 display: inline-block;
 background: rgba(184, 134, 11, 0.15);
 color: #7a552e;
 padding: 0.4rem 1.5rem;
 border-radius: 40px;
 font-size: 0.85rem;
 font-weight: 500;
 margin-top: 0.75rem;
 border: 1px solid rgba(184, 134, 11, 0.2);
 }

 @keyframes fadeSlideUp {
 from {
 opacity: 0;
 transform: translateY(30px);
 }
 to {
 opacity: 1;
 transform: translateY(0);
 }
 }

 /* ===== STORY INTRO ===== */
 .story-intro {
 padding: 2.5rem 2.5rem 1.5rem;
 font-size: 1.05rem;
 color: #5c3b1f;
 }

 .story-intro p {
 margin-bottom: 1.2rem;
 line-height: 1.9;
 }

 .story-intro p:last-of-type {
 margin-bottom: 0;
 }

 .story-intro strong {
 color: #b8860b;
 font-weight: 600;
 }

 .story-intro a {
 color: #b8860b;
 text-decoration: none;
 font-weight: 500;
 border-bottom: 1px solid rgba(184, 134, 11, 0.3);
 transition: border-color 0.3s ease;
 }

 .story-intro a:hover {
 border-color: #b8860b;
 }

 /* ===== QUOTE BOX ===== */
 .quote-box {
 background: #fef8e7;
 padding: 1.2rem 1.8rem;
 border-radius: 24px;
 margin: 1.5rem 0;
 border-left: 5px solid #b8860b;
 position: relative;
 }

 .quote-box p {
 margin: 0;
 font-style: italic;
 color: #5c3b1f;
 font-size: 1.05rem;
 }

 .quote-box .quote-icon {
 font-size: 1.5rem;
 color: #b8860b;
 opacity: 0.5;
 margin-right: 0.5rem;
 }

 /* ===== FEATURED IMAGE ===== */
 .featured-image-wrap {
 padding: 0 2.5rem 1.5rem;
 text-align: center;
 }

 .featured-image-wrap .img-container {
 border-radius: 28px;
 overflow: hidden;
 border: 1px solid rgba(184, 134, 11, 0.2);
 box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
 }

 .featured-image-wrap .img-container img {
 width: 100%;
 height: auto;
 display: block;
 }

 .featured-image-wrap .img-caption {
 font-size: 0.75rem;
 color: #a28b6f;
 margin-top: 0.5rem;
 letter-spacing: 0.3px;
 }

 /* ===== PRODUCT GRID ===== */
 .product-grid {
 display: grid;
 grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
 gap: 2rem;
 padding: 1.5rem 2.5rem 2.5rem;
 }

 .product-card {
 background: #fffef8;
 border-radius: 32px;
 overflow: hidden;
 transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
 box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
 border: 1px solid rgba(184, 134, 11, 0.12);
 animation: cardFloat 0.6s ease-out backwards;
 }

 .product-card:nth-child(1) { animation-delay: 0.05s; }
 .product-card:nth-child(2) { animation-delay: 0.1s; }
 .product-card:nth-child(3) { animation-delay: 0.15s; }
 .product-card:nth-child(4) { animation-delay: 0.2s; }
 .product-card:nth-child(5) { animation-delay: 0.25s; }

 .product-card:hover {
 transform: translateY(-12px) scale(1.01);
 box-shadow: 0 28px 40px -18px rgba(0, 0, 0, 0.2);
 border-color: rgba(184, 134, 11, 0.35);
 }

 @keyframes cardFloat {
 from {
 opacity: 0;
 transform: translateY(30px);
 }
 to {
 opacity: 1;
 transform: translateY(0);
 }
 }

 .product-card .img-placeholder {
 width: 100%;
 aspect-ratio: 1 / 1.1;
 background: #f9f2e6;
 display: flex;
 align-items: center;
 justify-content: center;
 border-bottom: 2px solid #e8d5b5;
 overflow: hidden;
 }

 .product-card .img-placeholder img {
 width: 100%;
 height: 100%;
 object-fit: cover;
 transition: transform 0.6s ease;
 }

 .product-card:hover .img-placeholder img {
 transform: scale(1.04);
 }

 .product-card .product-info {
 padding: 1.2rem 1.4rem 1.4rem;
 }

 .product-card .product-info h3 {
 font-size: 1.15rem;
 color: #5c3b1f;
 font-weight: 600;
 margin-bottom: 0.4rem;
 }

 .product-card .product-info .product-rating {
 display: flex;
 align-items: center;
 gap: 0.3rem;
 margin-bottom: 0.5rem;
 }

 .product-card .product-info .product-rating span {
 color: #b8860b;
 font-size: 0.9rem;
 }

 .product-card .product-info .product-rating .rating-text {
 color: #a28b6f;
 font-size: 0.75rem;
 }

 .product-card .product-info p {
 font-size: 0.9rem;
 color: #6b4a2a;
 line-height: 1.7;
 margin-bottom: 0.8rem;
 }

 .btn-shop {
 display: inline-block;
 background: #5c3b1f;
 color: #fef3e2;
 padding: 0.5rem 1.4rem;
 border-radius: 40px;
 text-decoration: none;
 font-weight: 500;
 font-size: 0.85rem;
 transition: all 0.3s ease;
 border: none;
 cursor: pointer;
 }

 .btn-shop:hover {
 background: #b8860b;
 transform: scale(0.97);
 box-shadow: 0 4px 15px rgba(184, 134, 11, 0.3);
 }

 .btn-shop::after {
 content: ' →';
 transition: transform 0.3s ease;
 display: inline-block;
 }

 .btn-shop:hover::after {
 transform: translateX(4px);
 }

 /* ===== COUPON BOX ===== */
 .coupon-box {
 background: linear-gradient(135deg, #fef6e8, #fbefdb);
 margin: 0 2.5rem 2.5rem;
 border-radius: 32px;
 text-align: center;
 padding: 2rem;
 border: 1px solid rgba(184, 134, 11, 0.15);
 position: relative;
 overflow: hidden;
 }

 .coupon-box::before {
 content: '✦ ✦ ✦';
 position: absolute;
 top: -10px;
 right: -10px;
 font-size: 3rem;
 color: rgba(184, 134, 11, 0.06);
 letter-spacing: 10px;
 }

 .coupon-box h3 {
 font-size: 1.6rem;
 color: #5c3b1f;
 font-weight: 700;
 margin-bottom: 0.5rem;
 }

 .coupon-box .coupon-code {
 display: inline-block;
 background: #5c3b1f;
 color: #fef3e2;
 padding: 0.4rem 2rem;
 border-radius: 40px;
 font-weight: 700;
 font-size: 1.2rem;
 letter-spacing: 3px;
 margin: 0.5rem 0;
 }

 .coupon-box .discount-text {
 color: #7a552e;
 font-weight: 500;
 font-size: 1.05rem;
 }

 .coupon-box p {
 color: #6b4a2a;
 font-size: 0.95rem;
 margin-top: 0.75rem;
 line-height: 1.7;
 }

 .coupon-box p strong {
 color: #b8860b;
 }

 /* ===== FOOTER ===== */
 .footer-note {
 background: #2c241a;
 color: #ddcfb2;
 text-align: center;
 padding: 1.2rem;
 font-size: 0.75rem;
 letter-spacing: 0.3px;
 }

 .footer-note p {
 margin-bottom: 0.2rem;
 }

 .footer-note p:last-child {
 margin-bottom: 0;
 font-size: 0.65rem;
 opacity: 0.7;
 }

 .footer-note .footer-divider {
 display: inline-block;
 width: 30px;
 height: 1px;
 background: rgba(221, 207, 178, 0.3);
 margin: 0 0.5rem;
 vertical-align: middle;
 }

 /* ===== RESPONSIVE ===== */
 @media (max-width: 992px) {
 .hero-luxury h1 { font-size: 2.2rem; }
 .product-grid {
 grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
 padding: 1.5rem;
 }
 }

 @media (max-width: 768px) {
 body { padding: 1rem; }
 .blog-card { border-radius: 32px; }
 .hero-luxury { padding: 2rem 1.5rem; }
 .hero-luxury h1 { font-size: 1.7rem; }
 .hero-luxury .subtitle { font-size: 1rem; }
 .story-intro { padding: 1.5rem 1.5rem 0.5rem; font-size: 0.95rem; }
 .featured-image-wrap { padding: 0 1.5rem 1rem; }
 .product-grid {
 grid-template-columns: 1fr 1fr;
 gap: 1.2rem;
 padding: 1rem 1.5rem 1.5rem;
 }
 .coupon-box { margin: 0 1.5rem 1.5rem; padding: 1.5rem; }
 .coupon-box h3 { font-size: 1.3rem; }
 .quote-box { padding: 1rem 1.2rem; margin: 1rem 0; }
 }

 @media (max-width: 480px) {
 .hero-luxury h1 { font-size: 1.4rem; }
 .product-grid {
 grid-template-columns: 1fr;
 gap: 1.2rem;
 padding: 0.8rem 1.2rem 1.2rem;
 }
 .product-card .product-info { padding: 1rem; }
 .coupon-box { margin: 0 1.2rem 1.2rem; padding: 1.2rem; }
 .coupon-box .coupon-code { font-size: 1rem; padding: 0.3rem 1.5rem; }
 .story-intro { padding: 1rem 1.2rem 0.5rem; font-size: 0.9rem; }
 .featured-image-wrap { padding: 0 1.2rem 0.8rem; }
 }
 &lt;/style&gt;
&lt;/head&gt;

