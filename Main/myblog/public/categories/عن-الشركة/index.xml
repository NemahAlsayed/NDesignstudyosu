      <description>&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&#34;ar&#34; dir=&#34;rtl&#34;&gt;&#xA;&lt;head&gt;&#xA;&lt;meta charset=&#34;UTF-8&#34;&gt;&#xA;&lt;meta name=&#34;viewport&#34; content=&#34;width=device-width, initial-scale=1.0, viewport-fit=cover&#34;&gt;&#xA;&lt;style&gt;&#xA;/* RESET */&#xA;* { margin: 0; padding: 0; box-sizing: border-box; }&#xA;&#xA;/* GLOBAL */&#xA;.about-studio {&#xA;    font-family: &#39;Segoe UI&#39;, system-ui, sans-serif;&#xA;    background: linear-gradient(145deg, #faf6ef 0%, #f5ede0 100%);&#xA;    padding: 2rem 1rem;&#xA;    line-height: 1.7;&#xA;    color: #4a3724;&#xA;}&#xA;&#xA;.about-card {&#xA;    max-width: 1200px;&#xA;    margin: 0 auto;&#xA;    background: #ffffff;&#xA;    border-radius: 48px;&#xA;    overflow: hidden;&#xA;    box-shadow: 0 35px 50px -25px rgba(0, 0, 0, 0.2);&#xA;}&#xA;&#xA;/* HERO */&#xA;.hero-about {&#xA;    background: linear-gradient(135deg, #f3e5c9 0%, #e8d5b5 50%, #dcc49a 100%);&#xA;    padding: 3rem 2rem;&#xA;    text-align: center;&#xA;    border-bottom: 3px solid #b8860b;&#xA;    animation: softGlow 3s infinite alternate;&#xA;}&#xA;@keyframes softGlow {&#xA;    0% { background: linear-gradient(135deg, #f3e5c9, #e8d5b5, #dcc49a); }&#xA;    100% { background: linear-gradient(135deg, #f7efdf, #ede1c6, #e0cdad); }&#xA;}&#xA;&#xA;.hero-about h1 {&#xA;    font-size: 2.8rem;&#xA;    color: #5c3b1f;&#xA;    margin-bottom: 0.5rem;&#xA;    animation: fadeSlideUp 0.8s ease-out;&#xA;}&#xA;@keyframes fadeSlideUp {&#xA;    from { opacity: 0; transform: translateY(20px); }&#xA;    to { opacity: 1; transform: translateY(0); }&#xA;}&#xA;&#xA;/* CONTENT SECTIONS */&#xA;.content-section {&#xA;    padding: 2rem;&#xA;    border-bottom: 1px solid rgba(184, 134, 11, 0.1);&#xA;}&#xA;&#xA;.section-title {&#xA;    font-size: 1.8rem;&#xA;    color: #5c3b1f;&#xA;    margin-bottom: 1rem;&#xA;    position: relative;&#xA;    display: inline-block;&#xA;}&#xA;.section-title:after {&#xA;    content: &#39;&#39;;&#xA;    position: absolute;&#xA;    bottom: -8px;&#xA;    right: 0;&#xA;    width: 60px;&#xA;    height: 3px;&#xA;    background: #b8860b;&#xA;    border-radius: 3px;&#xA;}&#xA;&#xA;/* VALUES GRID */&#xA;.values-grid {&#xA;    display: grid;&#xA;    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));&#xA;    gap: 2rem;&#xA;    margin-top: 2rem;&#xA;}&#xA;&#xA;.value-card {&#xA;    background: #fffef8;&#xA;    border-radius: 24px;&#xA;    padding: 1.5rem;&#xA;    text-align: center;&#xA;    transition: all 0.3s ease;&#xA;    border: 1px solid rgba(184, 134, 11, 0.15);&#xA;}&#xA;.value-card:hover {&#xA;    transform: translateY(-8px);&#xA;    box-shadow: 0 15px 30px -12px rgba(0, 0, 0, 0.15);&#xA;    border-color: rgba(184, 134, 11, 0.4);&#xA;}&#xA;&#xA;.value-icon {&#xA;    font-size: 3rem;&#xA;    margin-bottom: 1rem;&#xA;}&#xA;&#xA;.value-card h3 {&#xA;    color: #5c3b1f;&#xA;    margin-bottom: 0.5rem;&#xA;}&#xA;&#xA;/* TEAM GRID */&#xA;.team-grid {&#xA;    display: grid;&#xA;    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));&#xA;    gap: 2rem;&#xA;    margin-top: 2rem;&#xA;}&#xA;&#xA;.team-member {&#xA;    background: #fffef8;&#xA;    border-radius: 32px;&#xA;    overflow: hidden;&#xA;    text-align: center;&#xA;    transition: all 0.4s ease;&#xA;    border: 1px solid rgba(184, 134, 11, 0.15);&#xA;}&#xA;.team-member:hover {&#xA;    transform: translateY(-8px);&#xA;    box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.15);&#xA;}&#xA;&#xA;.member-avatar {&#xA;    width: 150px;&#xA;    height: 150px;&#xA;    border-radius: 50%;&#xA;    background: linear-gradient(135deg, #e8d5b5, #dcc49a);&#xA;    margin: 1.5rem auto 0;&#xA;    display: flex;&#xA;    align-items: center;&#xA;    justify-content: center;&#xA;    font-size: 4rem;&#xA;}&#xA;&#xA;.team-member h3 {&#xA;    color: #5c3b1f;&#xA;    margin-top: 1rem;&#xA;}&#xA;&#xA;.member-role {&#xA;    color: #b8860b;&#xA;    font-weight: 500;&#xA;    margin: 0.3rem 0;&#xA;}&#xA;&#xA;.member-bio {&#xA;    padding: 0 1rem 1.5rem;&#xA;    font-size: 0.9rem;&#xA;    color: #6b4a2a;&#xA;}&#xA;&#xA;/* QUOTE SECTION */&#xA;.quote-section {&#xA;    background: linear-gradient(135deg, #fef6e8, #fbefdb);&#xA;    margin: 1rem 1.5rem 2rem;&#xA;    border-radius: 32px;&#xA;    text-align: center;&#xA;    padding: 2rem;&#xA;}&#xA;.quote-text {&#xA;    font-size: 1.3rem;&#xA;    font-style: italic;&#xA;    color: #5c3b1f;&#xA;    max-width: 700px;&#xA;    margin: 0 auto;&#xA;}&#xA;.quote-author {&#xA;    margin-top: 1rem;&#xA;    color: #b8860b;&#xA;    font-weight: 500;&#xA;}&#xA;&#xA;/* FOOTER */&#xA;.footer-note {&#xA;    background: #2c241a;&#xA;    color: #ddcfb2;&#xA;    text-align: center;&#xA;    padding: 1rem;&#xA;    font-size: 0.7rem;&#xA;}&#xA;&#xA;/* BUTTON */&#xA;.btn-contact {&#xA;    display: inline-block;&#xA;    background: #5c3b1f;&#xA;    color: #fef3e2;&#xA;    padding: 0.8rem 2rem;&#xA;    border-radius: 40px;&#xA;    text-decoration: none;&#xA;    font-weight: 500;&#xA;    transition: all 0.25s;&#xA;    margin-top: 1rem;&#xA;}&#xA;.btn-contact:hover {&#xA;    background: #b8860b;&#xA;    transform: scale(1.02);&#xA;}&#xA;&lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&#xA;&lt;body&gt;&#xA;&lt;div class=&#34;about-studio&#34;&gt;&#xA;&lt;div class=&#34;about-card&#34;&gt;&#xA;&#xA;&lt;!-- HERO --&gt;&#xA;&lt;div class=&#34;hero-about&#34;&gt;&#xA;    &lt;h1&gt;📖 قصة N Design Studio&lt;/h1&gt;&#xA;    &lt;p style=&#34;color:#7a552e; font-size:1.2rem;&#34;&gt;حيث يلتقي الإبداع بالدقة&lt;/p&gt;</description>
